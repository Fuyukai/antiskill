WARNING_FLAGS="-Werror=odr -Werror=lto-type-mismatch -Werror=strict-aliasing"  # from lto wiki page

COMMON_FLAGS="-O3 -pipe -march=native -mtune=native -fno-omit-frame-pointer -mno-omit-leaf-frame-pointer -fno-semantic-interposition -flto=12 -fno-math-errno -fno-signed-zeros -fno-trapping-math ${WARNING_FLAGS}"
CFLAGS="${COMMON_FLAGS}"
CXXFLAGS="${COMMON_FLAGS}"
